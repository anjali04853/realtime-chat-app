# Port the HTTP + Socket.io server listens on
PORT=4000

# Allowed origins for CORS (comma-separated), or * for any
CORS_ORIGIN=*

# Optional: MongoDB connection string. If empty, messages are stored in data/messages.json
MONGODB_URI=

# Optional: path of the JSON file used when MONGODB_URI is empty
# DATA_FILE=./data/messages.json

# Optional: maximum message length (characters)
MESSAGE_MAX_LENGTH=1000
